# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string used by Prisma in production.
# Example (replace angle-bracket values with your real credentials):
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public"

# ─── Authentication ────────────────────────────────────────────────────────────
# Strong random secret used to sign / verify JWT tokens.
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-a-strong-random-secret"

# ─── Next.js / Deployment URLs ────────────────────────────────────────────────
# Canonical public URL of the deployed application (no trailing slash).
NEXTAUTH_URL="https://your-domain.com"

# Public base URL exposed to the browser (used for QR-code links, etc.).
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="production"
