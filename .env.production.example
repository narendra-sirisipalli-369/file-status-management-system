# DEPLOYMENT INSTRUCTIONS:
# Copy this file to .env and replace the JWT_SECRET placeholder with a real
# 32-character (or longer) random string before running `docker-compose up`.
# Example: openssl rand -hex 32

NODE_ENV=production

PORT=3000

DATABASE_URL="file:./data/production.db"

JWT_SECRET="generate_a_secure_32_character_string_for_production"
