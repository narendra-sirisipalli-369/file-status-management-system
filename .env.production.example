# DEPLOYMENT INSTRUCTIONS:
# Copy this file to .env and replace the placeholders below before running
# `npm run build && npm run migrate && npm run start`.
# Generate secrets with: openssl rand -hex 32

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (plain `pg`, no ORM).

NODE_ENV=production

PORT=3000

DATABASE_URL="postgresql://fsms:generate_a_secure_password_for_production@localhost:5432/fsms"

JWT_SECRET="generate_a_secure_32_character_string_for_production"

NEXTAUTH_URL="https://your-domain.example"
NEXT_PUBLIC_BASE_URL="https://your-domain.example"

# Shared secret the SMS-sending Android device sends as the x-device-key
# header to /api/sms-queue/device — configure the same value on the device.
SMS_DEVICE_API_KEY="generate_a_secure_32_character_string_for_production"
