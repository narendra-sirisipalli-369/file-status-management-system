generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── ROLES (per FSMS_Report.pdf) ──────────────────────────────────────────────
// B_LOGO           — Super Admin : Full system control, creates all credentials
// D_LOGO           — Admin       : Verification, remarks, may create staff if authorised
// MCPO             — Admin       : Administrative access
// INWARD           — Operator    : File entry, QR generation, full status updates
// MAILMAN_INTERNAL — Internal Courier : Received/Submitted movement only
// MAILMAN_EXTERNAL — External Courier : Received/Submitted movement only
// STORE_OFFICE     — Store       : File entry, report viewing, receiving work
// IFA              — Finance     : Approves transactions, releases budget
// CO_SIR           — Approver    : Approval authority (files ≤ Rs. 1 lakh)
// KIOSK_USER       — End User    : Shared department login, view-only file status

model User {
  id                   String         @id @default(cuid())
  username             String         @unique
  password             String
  role                 String         // B_LOGO | D_LOGO | MCPO | INWARD | MAILMAN_INTERNAL | MAILMAN_EXTERNAL | STORE_OFFICE | IFA | CO_SIR | KIOSK_USER
  department           String?
  createdFiles         FileRecord[]   @relation("FileCreatedBy")
  statusHistoryEntries StatusHistory[] @relation("StatusHistoryActor")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([username])
  @@index([role])
}

model FileRecord {
  id                String          @id @default(cuid())
  fileId            String          @unique @default(cuid())

  /// Secure IND-CV tracking ID encoded into the physical QR.
  /// Format: [SMS-RefNo]-IND-CV-[YYYYMMDD]-[8-char-crypto-hex]
  /// Example: 1045-IND-CV-20260411-a7b8c9d0
  /// Strictly unique and indexed for exact kiosk lookups.
  secureTrackingId  String          @unique

  smsRefNo          String          @unique
  description       String
  proposalValue     Float
  head              String
  dateSubmission    DateTime        @default(now())
  status            String          @default("Inward")
  mobileNumber      String          @default("")
  typeProcessing    String
  department        String
  createdById       String?
  createdBy         User?           @relation("FileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  histories         StatusHistory[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([secureTrackingId])   // O(1) kiosk QR lookup
  @@index([smsRefNo])           // O(1) admin ref search
  @@index([fileId])             // O(1) QR resolver fallback
  @@index([createdById])
  @@index([status])
  @@index([dateSubmission])
  @@index([department])
}

model StatusHistory {
  id            String     @id @default(cuid())
  fileRecord    FileRecord @relation(fields: [fileRecordId], references: [id], onDelete: Cascade)
  fileRecordId  String
  stageName     String
  inspectionBy  String
  remarks       String
  actorUserId   String?
  actorUser     User?      @relation("StatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  timestamp     DateTime   @default(now())

  @@index([fileRecordId])
  @@index([actorUserId])
  @@index([timestamp])
}
